# ARIA v4.0 Environment Configuration

# Network Analysis
NETWORK_TYPE=drive
TARGET_AREA=Hualien City, Taiwan
DEFAULT_SPEED=40
CENTRALITY_NORMALIZE=true
ISOCHRONE_ALPHA=0.005

# Rainfall-Congestion Mapping (mm/hr)
RAIN_LIGHT=15
RAIN_MODERATE=30
RAIN_HEAVY=50
RAIN_EXTREME=80

# Data Paths (relative to project root)
BASE_DIR=d:/Class_satellite
WEEK4_DIR=d:/Class_satellite/HW4
WEEK5_DIR=d:/Class_satellite/HW5
WEEK6_DIR=d:/Class_satellite/HW6

# File Paths
SHELTER_FILE=d:/Class_satellite/HW4/outputs/shelters_composite_risk.csv
DEM_FILE=d:/Class_satellite/HW4/dem_20m_hualien.tif
RAINFALL_JSON=d:/Class_satellite/HW6/fungwong_202511.json
KRIGING_RAINFALL=d:/Class_satellite/HW6/week6_outputs/kriging_rainfall.tif
KRIGING_VARIANCE=d:/Class_satellite/HW6/week6_outputs/kriging_variance.tif

# Output Files
NETWORK_GRAPHML=hualien_network.graphml
OUTPUTS_DIR=outputs

# AI Features (Optional - Get from Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here
